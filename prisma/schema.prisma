generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  TRIAL
  PENDING
  SUSPENDED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InvoiceStatus {
  PAID
  DUE
  FAILED
  REFUNDED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
}

enum UserRole {
  PLATFORM_ADMIN
  TENANT_ADMIN
  CUSTOMER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId   String?   @unique
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
}

model Plan {
  id          String    @id @default(cuid())
  name        String    @unique
  price       Decimal   @db.Decimal(10, 2)
  interval    String    @default("month")
  tenantLimit Int?
  staffLimit  Int?
  features    String[]
  active      Boolean   @default(true)
  tenants     Tenant[]
  invoices    Invoice[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Tenant {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  ownerName       String
  email           String        @unique
  phone           String?
  address         String?
  city            String?
  tagline         String?
  description     String?
  imageUrl        String?
  amenities       String[]
  currency        String        @default("USD")
  timezone        String        @default("UTC")
  confirmation    Boolean       @default(true)
  reminders       Boolean       @default(true)
  loyalty         Boolean       @default(false)
  pointsPerDollar Int           @default(0)
  status          TenantStatus  @default(TRIAL)
  planId          String?
  plan            Plan?         @relation(fields: [planId], references: [id])
  locations       Location[]
  customers       Customer[]
  services        Service[]
  staff           Staff[]
  appointments    Appointment[]
  rewards         Reward[]
  reviews         Review[]
  invoices        Invoice[]
  tickets         Ticket[]
  users           User[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
}

model Location {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String
  city      String?
  timezone  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String?
  points       Int           @default(0)
  notes        String?
  appointments Appointment[]
  reviews      Review[]
  user         User?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId, name])
}

model Service {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  category     String
  duration     Int
  price        Decimal        @db.Decimal(10, 2)
  active       Boolean        @default(true)
  description  String?
  staff        StaffService[]
  appointments Appointment[]
  reviews      Review[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

model Staff {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String?
  role         String
  active       Boolean        @default(true)
  services     StaffService[]
  hours        WorkDay[]
  appointments Appointment[]
  reviews      Review[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId, active])
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model WorkDay {
  id        String       @id @default(cuid())
  staffId   String
  staff     Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  enabled   Boolean      @default(true)
  startTime String
  endTime   String
  breaks    StaffBreak[]

  @@unique([staffId, dayOfWeek])
}

model StaffBreak {
  id        String  @id @default(cuid())
  workDayId String
  workDay   WorkDay @relation(fields: [workDayId], references: [id], onDelete: Cascade)
  startTime String
  endTime   String
}

model Appointment {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id])
  serviceId  String
  service    Service           @relation(fields: [serviceId], references: [id])
  staffId    String
  staff      Staff             @relation(fields: [staffId], references: [id])
  startsAt   DateTime
  status     AppointmentStatus @default(PENDING)
  notes      String?
  loyaltyPointsAwarded Int     @default(0)
  review     Review?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([tenantId, startsAt])
  @@index([staffId, startsAt])
}

model Reward {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  points      Int
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  serviceId     String?
  service       Service?     @relation(fields: [serviceId], references: [id])
  staffId       String?
  staff         Staff?       @relation(fields: [staffId], references: [id])
  authorName    String
  rating        Int
  text          String
  createdAt     DateTime     @default(now())
}

model Invoice {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId    String?
  plan      Plan?         @relation(fields: [planId], references: [id])
  amount    Decimal       @db.Decimal(10, 2)
  status    InvoiceStatus
  issuedAt  DateTime      @default(now())
  createdAt DateTime      @default(now())
}

model Ticket {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject   String
  category  String
  priority  TicketPriority @default(NORMAL)
  status    TicketStatus   @default(OPEN)
  message   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model PlatformSettings {
  id              Int      @id @default(1)
  platformName    String
  supportEmail    String
  trialDays       Int      @default(14)
  tenantApproval  Boolean  @default(false)
  maintenanceMode Boolean  @default(false)
  incidentEmails  Boolean  @default(true)
  billingEmails   Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}
